BACKEND_URL=http://localhost:8000
# Must equal Backend's CORE_INTERNAL_TOKEN (section 50 - separate secret per caller)
CORE_AUTH_TOKEN=

# From https://my.telegram.org - never hardcode these (section 11)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Moon Bot's own @username (no @) - used for the auto-subscribe+pin step
# right after a successful login, so Bot API can message this account later
STORE_BOT_USERNAME=

LOG_LEVEL=INFO
ENVIRONMENT=development

MODULES_DIRECTORY=./modules_data
DATA_DIRECTORY=./data

HEARTBEAT_INTERVAL_SECONDS=300
DEVICE_NAME=termux

# web = local login page at http://LOCAL_AUTH_HOST:LOCAL_AUTH_PORT/<token>
# terminal = old input()-based prompts, for headless setups
AUTH_METHOD=web
LOCAL_AUTH_HOST=127.0.0.1
LOCAL_AUTH_PORT=8765
